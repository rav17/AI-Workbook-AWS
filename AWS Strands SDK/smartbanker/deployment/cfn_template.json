{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SmartBanker Lambda tool functions for AgentCore Gateway",
  "Resources": {
    "ToolLambdaRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "smartbanker-tool-lambda-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "DynamoDBAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Query",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": "arn:aws:dynamodb:us-east-1:533267042240:table/smartbanker_stm"
                }
              ]
            }
          }
        ]
      }
    },
    "Fntransactionfetcher": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "smartbanker-transaction_fetcher",
        "Runtime": "python3.11",
        "Handler": "handler.handler",
        "Role": {
          "Fn::GetAtt": [
            "ToolLambdaRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": "smartbanker-lambda-deploy-533267042240",
          "S3Key": "lambdas/transaction_fetcher.zip"
        },
        "Timeout": 30,
        "MemorySize": 256
      }
    },
    "Fnbalancechecker": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "smartbanker-balance_checker",
        "Runtime": "python3.11",
