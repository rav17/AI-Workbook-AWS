<mxfile host="Electron"><diagram name="AIOps Self-Healing Architecture" id="aiops-arch"><mxGraphModel dx="1643" dy="776" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="&lt;b&gt;AIOps Self-Healing Infrastructure + AWS DevOps Agent - AWS Architecture (dev)&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;verticalAlign=top;whiteSpace=wrap;"><mxGeometry x="400" y="8" width="1100" height="30" as="geometry" /></mxCell><mxCell id="l_src" parent="1" vertex="1" value="1. Alert Sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#666666;"><mxGeometry x="10" y="80" width="180" height="560" as="geometry" /></mxCell><mxCell id="l_trg" parent="1" vertex="1" value="2. Alert Trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E7157B;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#E7157B;"><mxGeometry x="240" y="80" width="170" height="560" as="geometry" /></mxCell><mxCell id="l_edge" parent="1" vertex="1" value="3. Edge (public, secured)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#8C4FFF;"><mxGeometry x="460" y="80" width="180" height="560" as="geometry" /></mxCell><mxCell id="l_vpc" parent="1" vertex="1" value="4. Private VPC - ECS Fargate (no public IP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#ED7100;"><mxGeometry x="690" y="80" width="600" height="560" as="geometry" /></mxCell><mxCell id="l_data" parent="1" vertex="1" value="5. State, Queue, AI, Email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C925D1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#C925D1;"><mxGeometry x="1400" y="80" width="200" height="560" as="geometry" /></mxCell><mxCell id="l_op" parent="1" vertex="1" value="8. Operator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DD344C;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#DD344C;"><mxGeometry x="1650" y="80" width="190" height="910" as="geometry" /></mxCell><mxCell id="l_exec" parent="1" vertex="1" value="6. Remediation Target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7AA116;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#7AA116;"><mxGeometry x="690" y="690" width="300" height="300" as="geometry" /></mxCell><mxCell id="l_agent" parent="1" vertex="1" value="7. AWS DevOps Agent (root cause analysis + advisory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#01A88D;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#01A88D;"><mxGeometry x="1040" y="690" width="590" height="300" as="geometry" /></mxCell><mxCell id="l_obs" parent="1" vertex="1" value="9. Observability &amp; Governance (all stacks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#232F3E;"><mxGeometry x="10" y="1020" width="1830" height="150" as="geometry" /></mxCell><mxCell id="cw_alarm" parent="1" vertex="1" value="CloudWatch Alarms&#10;(target CPU / memory / network)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;"><mxGeometry x="76" y="130" width="48" height="48" as="geometry" /></mxCell><mxCell id="demo" parent="1" vertex="1" value="Demo scripts&#10;break_target.py&#10;trigger_p1_incident.py" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;"><mxGeometry x="76" y="290" width="48" height="48" as="geometry" /></mxCell><mxCell id="prom" parent="1" vertex="1" value="Prometheus /&#10;Alertmanager&#10;(local, on-prem)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.corporate_data_center;"><mxGeometry x="76" y="460" width="48" height="48" as="geometry" /></mxCell><mxCell id="sns_alarm" parent="1" vertex="1" value="SNS alarm topic" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;"><mxGeometry x="301" y="130" width="48" height="48" as="geometry" /></mxCell><mxCell id="trig_fn" parent="1" vertex="1" value="Alert Trigger Lambda&#10;aiops-alert-trigger-dev&#10;(Alertmanager payload)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;"><mxGeometry x="301" y="290" width="48" height="48" as="geometry" /></mxCell><mxCell id="waf" parent="1" vertex="1" value="AWS WAF&#10;rate limit, size,&#10;managed rules" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;"><mxGeometry x="478" y="130" width="48" height="48" as="geometry" /></mxCell><mxCell id="apigw" parent="1" vertex="1" value="API Gateway (HTTP)&#10;POST /webhook&#10;GET/POST /approve" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;"><mxGeometry x="478" y="290" width="48" height="48" as="geometry" /></mxCell><mxCell id="vpclink" parent="1" vertex="1" value="VPC Link" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;"><mxGeometry x="478" y="450" width="48" height="48" as="geometry" /></mxCell><mxCell id="ecs" parent="1" vertex="1" value="ECS Fargate&#10;(FastAPI)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;"><mxGeometry x="706" y="130" width="48" height="48" as="geometry" /></mxCell><mxCell id="cmap" parent="1" vertex="1" value="Cloud Map" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloud_map;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;"><mxGeometry x="706" y="270" width="48" height="48" as="geometry" /></mxCell><mxCell id="s1" parent="1" vertex="1" value="1  Normalize + dedup (fingerprint, storm detector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#ED7100;fontSize=9;"><mxGeometry x="830" y="110" width="440" height="38" as="geometry" /></mxCell><mxCell id="s2" parent="1" vertex="1" value="2  Enrich (asset inventory), redact sensitive labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#ED7100;fontSize=9;"><mxGeometry x="830" y="162" width="440" height="38" as="geometry" /></mxCell><mxCell id="s3" parent="1" vertex="1" value="3  Rule match: PlaybookMapper (playbook_mapping.yml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#ED7100;fontSize=9;"><mxGeometry x="830" y="214" width="440" height="38" as="geometry" /></mxCell><mxCell id="s4" parent="1" vertex="1" value="4  Guardrails: circuit breaker, blast radius, plan validator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#ED7100;fontSize=9;"><mxGeometry x="830" y="266" width="440" height="38" as="geometry" /></mxCell><mxCell id="s5" parent="1" vertex="1" value="5  No rule: Bedrock advice in ECS (skipped in advisory mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#ED7100;fontSize=9;"><mxGeometry x="830" y="318" width="440" height="38" as="geometry" /></mxCell><mxCell id="s6" parent="1" vertex="1" value="6  Approval email (signed single-use token), Executor; lock freed if alert clears" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#ED7100;fontSize=9;"><mxGeometry x="830" y="370" width="440" height="38" as="geometry" /></mxCell><mxCell id="s7" parent="1" vertex="1" value="7  DevOps Agent forwarder (critical, unmatched, failed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5EE;strokeColor=#01A88D;fontSize=9;"><mxGeometry x="830" y="422" width="440" height="38" as="geometry" /></mxCell><mxCell id="p_s1" parent="1" edge="1" source="s1" target="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;strokeColor=#232F3E;fontColor=#232F3E;endArrow=classic;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_s2" parent="1" edge="1" source="s2" target="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;strokeColor=#232F3E;fontColor=#232F3E;endArrow=classic;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_s3" parent="1" edge="1" source="s3" target="s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;strokeColor=#232F3E;fontColor=#232F3E;endArrow=classic;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_s4" parent="1" edge="1" source="s4" target="s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;strokeColor=#232F3E;fontColor=#232F3E;endArrow=classic;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_s5" parent="1" edge="1" source="s5" target="s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;strokeColor=#232F3E;fontColor=#232F3E;endArrow=classic;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_s6" parent="1" edge="1" source="s6" target="s7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;strokeColor=#232F3E;fontColor=#232F3E;endArrow=classic;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vpc_note" parent="1" vertex="1" value="Tasks run in private subnets. AWS API traffic uses VPC endpoints (DynamoDB, S3, SQS, SSM, Logs, Secrets Manager, Bedrock). Limits per task: 50 concurrent pipelines, 10 concurrent executions." style="text;html=1;fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;"><mxGeometry x="830" y="490" width="440" height="55" as="geometry" /></mxCell><mxCell id="vpc_note2" parent="1" vertex="1" value="&lt;b&gt;Rule mode&lt;/b&gt;: playbook found, operator approves, SSM runs it. &lt;b&gt;Advisory mode&lt;/b&gt; (devopsAgentAdvisoryEnabled): no playbook, so DevOps Agent investigates and the Findings Lambda emails one advisory with a suggested playbook. Flag off or forwarding failed: ECS sends the Bedrock advisory. Critical alerts also go to DevOps Agent." style="text;html=1;fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;"><mxGeometry x="830" y="550" width="440" height="85" as="geometry" /></mxCell><mxCell id="ddb" parent="1" vertex="1" value="DynamoDB&#10;incidents, approvals,&#10;dedup locks, tokens,&#10;audit, advisory leases" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;"><mxGeometry x="1476" y="105" width="48" height="48" as="geometry" /></mxCell><mxCell id="sqs" parent="1" vertex="1" value="SQS queue + DLQ&#10;(maxReceive 3)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;"><mxGeometry x="1476" y="205" width="48" height="48" as="geometry" /></mxCell><mxCell id="bedrock" parent="1" vertex="1" value="Amazon Bedrock&#10;Nova Lite/Pro,&#10;Claude Sonnet/Haiku" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;"><mxGeometry x="1476" y="280" width="48" height="48" as="geometry" /></mxCell><mxCell id="ses1" parent="1" vertex="1" value="Amazon SES&#10;approval and&#10;advisory emails" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;"><mxGeometry x="1476" y="400" width="48" height="48" as="geometry" /></mxCell><mxCell id="secrets" parent="1" vertex="1" value="Secrets Manager&#10;approval secret, API key,&#10;DevOps Agent webhook" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;"><mxGeometry x="1476" y="520" width="48" height="48" as="geometry" /></mxCell><mxCell id="ssm" parent="1" vertex="1" value="SSM Run Command&#10;(SendCommand)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;"><mxGeometry x="746" y="740" width="48" height="48" as="geometry" /></mxCell><mxCell id="ec2" parent="1" vertex="1" value="EC2 targets&#10;aiops-target-dev,&#10;aiops-target-secondary-dev" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;"><mxGeometry x="880" y="740" width="48" height="48" as="geometry" /></mxCell><mxCell id="playbooks" parent="1" vertex="1" value="Playbooks&#10;fix_high_cpu, fix_high_memory,&#10;clear_disk, restart_process,&#10;restart_service" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;"><mxGeometry x="746" y="860" width="48" height="48" as="geometry" /></mxCell><mxCell id="da_hook" parent="1" vertex="1" value="Generic webhook&#10;(HMAC, https)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;"><mxGeometry x="1070" y="740" width="48" height="48" as="geometry" /></mxCell><mxCell id="da_space" parent="1" vertex="1" value="Agent Space aiops-dev&#10;INVESTIGATION task,&#10;mitigation plan, read-only role" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.devops_guru;"><mxGeometry x="1210" y="740" width="48" height="48" as="geometry" /></mxCell><mxCell id="eb" parent="1" vertex="1" value="EventBridge&#10;source aws.aidevops&#10;Completed / Failed /&#10;Timed Out / Linked" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;"><mxGeometry x="1350" y="740" width="48" height="48" as="geometry" /></mxCell><mxCell id="find_fn" parent="1" vertex="1" value="Findings Lambda&#10;reads summary + mitigation plan,&#10;advisory or RCA email" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;"><mxGeometry x="1490" y="740" width="48" height="48" as="geometry" /></mxCell><mxCell id="da_web" parent="1" vertex="1" value="Operator web app&#10;(investigation UI)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;"><mxGeometry x="1070" y="880" width="48" height="48" as="geometry" /></mxCell><mxCell id="find_dlq" parent="1" vertex="1" value="Findings DLQ&#10;(failed invocations,&#10;14 days)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;"><mxGeometry x="1490" y="880" width="48" height="48" as="geometry" /></mxCell><mxCell id="operator" parent="1" vertex="1" value="Operator&#10;(approves, reads RCA)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;"><mxGeometry x="1680" y="150" width="48" height="48" as="geometry" /></mxCell><mxCell id="mail" parent="1" vertex="1" value="Operator mailbox" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;"><mxGeometry x="1680" y="440" width="48" height="48" as="geometry" /></mxCell><mxCell id="ses2" parent="1" vertex="1" value="Amazon SES&#10;RCA and advisory&#10;emails" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;"><mxGeometry x="1680" y="740" width="48" height="48" as="geometry" /></mxCell><mxCell id="flow" parent="1" vertex="1" value="&lt;b&gt;End-to-end flow&lt;/b&gt;&lt;br&gt;1. An alarm or demo script raises an alert; the Lambda posts it to API Gateway /webhook.&lt;br&gt;2. ECS normalizes, de-duplicates, enriches and matches a playbook.&lt;br&gt;3. Rule match: approval email (SES); the operator approves; SSM runs the fix. If the alert clears first, the approval is cancelled and its dedup lock released.&lt;br&gt;4. Critical alerts are also sent to AWS DevOps Agent; the Findings Lambda emails the RCA.&lt;br&gt;5. No match: sent to DevOps Agent. In advisory mode the Findings Lambda reads the root cause and mitigation plan (asks for one if missing), Bedrock picks a catalog playbook or drafts one, and one advisory email goes out. Otherwise ECS sends a Bedrock advisory.&lt;br&gt;6. Drafted playbooks are checked (allowed modules, no Jinja, no aws CLI, denied commands) and shown for review only.&lt;br&gt;DevOps Agent investigates only. Every change on a host still passes guardrails and human approval." style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;"><mxGeometry x="10" y="700" width="650" height="280" as="geometry" /></mxCell><mxCell id="cwl" parent="1" vertex="1" value="CloudWatch Logs&#10;/aiops/dev/ecs (JSON,&#10;incident_id)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;"><mxGeometry x="50" y="1060" width="48" height="48" as="geometry" /></mxCell><mxCell id="cwm" parent="1" vertex="1" value="CloudWatch Metrics&#10;AIOps/dev" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;"><mxGeometry x="220" y="1060" width="48" height="48" as="geometry" /></mxCell><mxCell id="cwa" parent="1" vertex="1" value="CloudWatch Alarms&#10;DLQ, AI latency,&#10;failure rate" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;"><mxGeometry x="390" y="1060" width="48" height="48" as="geometry" /></mxCell><mxCell id="sns_ops" parent="1" vertex="1" value="SNS ops topic" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;"><mxGeometry x="560" y="1060" width="48" height="48" as="geometry" /></mxCell><mxCell id="budget" parent="1" vertex="1" value="AWS Budgets&#10;(incl. DevOps Agent)" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;"><mxGeometry x="730" y="1060" width="48" height="48" as="geometry" /></mxCell><mxCell id="ecr" parent="1" vertex="1" value="ECR&#10;aiops:latest-dev" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;"><mxGeometry x="900" y="1060" width="48" height="48" as="geometry" /></mxCell><mxCell id="iam" parent="1" vertex="1" value="IAM least privilege,&#10;tag-scoped agent reads" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;labelPosition=c