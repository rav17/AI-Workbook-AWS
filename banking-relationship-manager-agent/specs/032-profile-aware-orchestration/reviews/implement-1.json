  "findings": [
    {
      "severity": "blocker",
      "file": "aria/agents/aria/receivables/rules.py",
      "section": "prior_allocation_status",
      "note": "For another payment on a candidate invoice this returns clear when the allocation is posted; it only blocks pending rows. This contradicts approved synthetic-policy.md section 2 (any pending/posted row blocks confidence) and FR-009, allowing a confident recommendation despite prior posted allocation. tests/unit/test_receivables_rules.py::test_only_pending_or_posted_allocations_block_candidates explicitly asserts the conflicting clear result."
    },
    {
      "severity": "major",
      "file": "demo/receivables_exception/service.py",
      "section": "ReceivablesWorkflowService.confirm",
      "note": "Confirmation validates the confirmation-binding expiry but never proposal.expires_at; LocalSQLiteStore.confirm likewise checks only binding expiry. Approval near the 30-minute proposal TTL can therefore create a task after proposal expiry while the 10-minute confirmation window remains open, contrary to contract C5 and task T014. Revalidate proposal TTL at confirmation and cover crossing the proposal-expiry boundary."
    },
    {
      "severity": "major",
      "file": "aria/agents/aria/receivables/engine.py",
      "section": "ReceivablesInvestigationEngine.__init__ / _FixtureClock",
      "note": "The default selects a fixed fixture clock, and demo/receivables_exception/app.py::main constructs the engine without an advancing clock; the service reuses it. In the actual default demo, evidence ages and proposal/confirmation times never advance, so freshness and expiry checks do not become stale after real waiting. Keep fixed time for evaluation only and verify elapsed-time behavior in the demo path."
    },
    {
      "severity": "warning",
      "file": "demo/receivables_exception/store.py",
      "section": "_new_decision / record_decision",
      "note": "Analyst-supplied rationale is persisted verbatim (up to 500 characters); the local UI accepts arbitrary text and there is no redaction or synthetic-only validation. This can persist real client details or credentials despite the synthetic-data-only boundary and constitution privacy rule. Avoid persisting free text or enforce a safe synthetic rationale policy."
    }
  ]
