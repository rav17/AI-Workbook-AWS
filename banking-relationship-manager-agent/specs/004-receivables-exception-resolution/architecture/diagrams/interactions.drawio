xCell id="e6" value="6. approve / revise / reject / escalate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="human" target="web"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="approval increments revision and issues opaque ID" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="web" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="bind opaque ID + payload hash/version; proposal 30m TTL + approval 10m window rechecked at service and store transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="web" target="store"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="exact committed retry returns same task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="store" target="replay"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="decision first: confirmation is stale" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="decision" target="store"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="task first: later decision cannot mutate task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="store" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="confirm displayed payload hash and proposal version" style="edgeStyle=orthogonalEdgeStyle;round