{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Kit Stage Contracts",
  "type": "object",
  "required": ["version", "contracts"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stageContract"
      }
    }
  },
  "$defs": {
    "stageContract": {
      "type": "object",
      "required": ["stage", "purpose", "inputs", "outputs", "acceptance_criteria", "review_focus"],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["id", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["id", "description", "required"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
