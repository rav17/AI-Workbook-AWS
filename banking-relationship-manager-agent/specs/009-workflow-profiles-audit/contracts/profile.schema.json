{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "stages", "depth", "gates"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["ideation", "specify", "clarify", "plan", "tasks", "analyze", "implement", "deploy", "operate"] }
    },
    "depth": { "enum": ["minimal", "standard", "comprehensive"] },
    "gates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["ideation", "specify", "clarify", "plan", "tasks", "analyze", "implement", "deploy", "operate"] }
    },
    "exemptions": {
      "type": "array",
      "items": { "enum": ["implement-without-tasks"] }
    }
  }
}
