{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "stages", "depth", "gates"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["ideation", "specify", "clarify", "plan", "tasks", "analyze", "implement", "deploy", "operate"] }
    },
    "depth": { "enum": ["minimal", "standard", "comprehensive"] },
    "execution": { "enum": ["inline", "delegated", "hybrid", "selective"] },
    "stage_contracts": { "type": "boolean" },
    "contract_inputs": { "type": "boolean" },
    "test_strategy": { "enum": ["standard", "required"] },
    "guard_policy": { "enum": ["", "standard", "strict"] },
    "ceremony": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learning": { "type": "boolean" },
        "reviews": { "type": "boolean" }
      }
    },
    "assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lead"],
        "properties": {
          "lead": { "type": "string" },
          "support": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "gates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["ideation", "specify", "clarify", "plan", "tasks", "analyze", "implement", "deploy", "operate"] }
    },
    "exemptions": {
      "type": "array",
      "items": { "enum": ["implement-without-tasks"] }
    }
  }
}
