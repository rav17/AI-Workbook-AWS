<mxfile host="app.diagrams.net"><diagram id="d1" name="Architecture on a Page"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Exercise 7 - Architecture on a Page: Aria on AWS" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1660" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Vision:&lt;/b&gt; A safe, compliant, context-aware AI relationship manager for Premier / Imperia clients with deterministic workflow state, guarded model use, and human escalation." style="text;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="45" width="1640" height="40" as="geometry"/></mxCell><mxCell id="c4" value="1. Channel&#10;Web / Mobile&#10;client" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="c5" value="2. Edge &amp; AuthN&#10;API Gateway +&#10;Cognito JWT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="3. Request Lambda&#10;identity, idempotency,&#10;session mapping" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="550" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="c7" value="4. AgentCore Runtime&#10;Aria agent (Strands)&#10;Guardrails - Workflow - Tools" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="810" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="c8" value="5. AI Services&#10;Bedrock Claude - Guardrails&#10;Knowledge Base - Memory" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="c9" value="6. Enterprise systems&#10;CRM - Core Banking -&#10;KYC/AML provider" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1410" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="155" as="sourcePoint"/><mxPoint x="290" y="155" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="155" as="sourcePoint"/><mxPoint x="550" y="155" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="" style="html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="155" as="sourcePoint"/><mxPoint x="810" y="155" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="" style="html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="155" as="sourcePoint"/><mxPoint x="1110" y="155" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="" style="html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="155" as="sourcePoint"/><mxPoint x="1410" y="155" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="Key architecture decisions" style="rounded=1;html=1;whiteSpace=wrap;arcSize=3;fillColor=none;dashed=1;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="800" height="420" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;AD1&lt;/b&gt; Authorization outside the model: Cognito + IAM + resource policy; tool visibility is not authz.&lt;br/&gt;&lt;b&gt;AD2&lt;/b&gt; Workflow state is authoritative (typed patches, revisions, dependency invalidation); memory never overrides it.&lt;br/&gt;&lt;b&gt;AD3&lt;/b&gt; Fail closed: guardrails, missing KYC provider, unavailable KB -&gt; escalate, never fabricate.&lt;br/&gt;&lt;b&gt;AD4&lt;/b&gt; Shared framework + manifest-driven agents; business logic stays in agent/domain modules.&lt;br/&gt;&lt;b&gt;AD5&lt;/b&gt; Managed serverless AgentCore (Runtime, Memory, Gateway) over self-run containers.&lt;br/&gt;&lt;b&gt;AD6&lt;/b&gt; 4 CDK stacks by lifecycle: Stateful -&gt; Application -&gt; Gateway -&gt; Runtime; SSM only for runtime handoff.&lt;br/&gt;&lt;b&gt;AD7&lt;/b&gt; Gateway publishes only no-argument risk questionnaire until user-to-customer mapping is approved.&lt;br/&gt;&lt;b&gt;AD8&lt;/b&gt; Memory writes disabled until data-owner retention/consent policy approved." style="text;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="760" height="360" as="geometry"/></mxCell><mxCell id="c17" value="Event-driven retention path" style="rounded=1;html=1;whiteSpace=wrap;arcSize=3;fillColor=none;dashed=1;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;strokeColor=#82b366;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="260" width="790" height="200" as="geometry"/></mxCell><mxCell id="c18" value="Banking events" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="320" width="150" height="60" as="geometry"/></mxCell><mxCell id="c19" value="EventBridge bus" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1060" y="320" width="150" height="60" as="geometry"/></mxCell><mxCell id="c20" value="Event Lambda&#10;(maturity &lt;= 30d,&#10;large outflow)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="320" width="170" height="60" as="geometry"/></mxCell><mxCell id="c21" value="SQS + DLQ -&gt;&#10;client / RM outreach" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1440" y="320" width="190" height="60" as="geometry"/></mxCell><mxCell id="c22" value="" style="html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="350" as="sourcePoint"/><mxPoint x="1060" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="" style="html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="350" as="sourcePoint"/><mxPoint x="1240" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="" style="html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1410" y="350" as="sourcePoint"/><mxPoint x="1440" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="Risks / open items" style="rounded=1;html=1;whiteSpace=wrap;arcSize=3;fillColor=none;dashed=1;strokeWidth=2;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;strokeColor=#b85450;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="490" width="790" height="190" as="geometry"/></mxCell><mxCell id="c26" value="- No authoritative KYC/CRM provider contract yet (recommendations fail closed).&lt;br/&gt;- SLOs (99.9%, p95 &amp;lt; 1s) proposed, not approved.&lt;br/&gt;- Memory extraction/retention policy and erasure SLA undecided.&lt;br/&gt;- Customer-specific Gateway actions need authenticated user-to-customer mapping.&lt;br/&gt;- AWS deployment / invocation not yet verified end to end." style="text;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="525" width="750" height="140" as="geometry"/></mxCell><mxCell id="c27" value="Cross-cutting: Observability (redacted logs, X-Ray, alarms) - Security (KMS, boundary, masking) - Delivery (CDK, OIDC, tests)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="1620" height="50" as="geometry"/></mxCell><mxCell id="c28" value="Quality: Ruff - typing - pytest/Hypothesis - CDK assertions - secret scan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="1620" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>