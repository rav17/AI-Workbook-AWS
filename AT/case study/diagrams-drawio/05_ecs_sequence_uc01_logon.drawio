            <mxPoint x="525" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 7. AuthService → SessionStore -->
        <mxCell id="m7" value="7. createSession(userId)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#d6b656;" edge="1" parent="1">
