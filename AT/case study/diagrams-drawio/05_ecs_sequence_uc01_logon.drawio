            <mxPoint x="525" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 9. AuthService → DialogControl (return token) -->
        <mxCell id="m9" value="9. sessionToken returned" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#82b366;dashed=1;" edge="1" parent="1">
          <mxGeometry x="525" y="570" relative="1" as="geometry">
