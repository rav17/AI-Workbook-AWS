            <mxPoint x="925" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 8. SessionStore → AuthService (return) -->
        <mxCell id="m8" value="8. sessionToken (JWT)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#d6b656;dashed=1;" edge="1" parent="1">
          <mxGeometry x="925" y="510" relative="1" as="geometry">
