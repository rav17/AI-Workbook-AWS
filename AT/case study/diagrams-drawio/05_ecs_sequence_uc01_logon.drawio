        <!-- 3. Respondent → DialogControl (submit credentials) -->
        <mxCell id="m3" value="3. submitCredentials(cfn, ecn)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6c8ebf;" edge="1" parent="1">
