        <!-- ===== MESSAGES ===== -->
        <!-- 1. Respondent → DialogControl -->
        <mxCell id="m1" value="1. requestLogonPage()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6c8ebf;" edge="1" parent="1">
