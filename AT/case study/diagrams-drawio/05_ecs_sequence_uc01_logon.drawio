            <mxPoint x="325" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 10. DialogControl → Respondent (redirect) -->
        <mxCell id="m10" value="10. redirect to InitialSection (token in cookie)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1">
