            <mxPoint x="525" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 5. AuthService → DAL -->
        <mxCell id="m5" value="5. lookupCredentials(cfn, ecn)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#d6b656;" edge="1" parent="1">
