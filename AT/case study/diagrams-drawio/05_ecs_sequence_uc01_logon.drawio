        <!-- 2. DialogControl → Respondent (return) -->
        <mxCell id="m2" value="2. displayLogonPage()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1">
