          </mxGeometry>
        </mxCell>

        <!-- 6. DAL → AuthService (return) -->
        <mxCell id="m6" value="6. credentialRecord (match confirmed)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#d6b656;dashed=1;" edge="1" parent="1">
          <mxGeometry x="725" y="410" relative="1" as="geometry">
