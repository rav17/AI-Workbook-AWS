          </mxGeometry>
        </mxCell>

        <!-- 4. DialogControl → AuthService -->
        <mxCell id="m4" value="4. authenticate(cfn, ecn)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#82b366;" edge="1" parent="1">
