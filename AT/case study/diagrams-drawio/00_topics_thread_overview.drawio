        <!-- Title -->
        <mxCell id="title" value="IBM Architectural Thinking — How All Topics Connect (ECS Thread)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="1200" height="42" as="geometry" />
        </mxCell>

        <!-- ===== MODULE BOXES ===== -->

        <!-- M01 -->
        <mxCell id="m01" value="📘 Module 01&lt;br/&gt;&lt;b&gt;Architectural Thinking&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;• Iterative process&lt;br/&gt;• Inputs → Process → Outputs&lt;br/&gt;• Avoid golden hammer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="185" height="130" as="geometry" />
        </mxCell>

        <!-- M02 -->
        <mxCell id="m02" value="📗 Module 02&lt;br/&gt;&lt;b&gt;What is Architecture?&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;• Structure + Behavior&lt;br/&gt;• Functional vs Operational&lt;br/&gt;• EA / SA / BA domains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00897b;strokeColor=#00695c;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="280" y="70" width="185" height="130" as="geometry" />
        </mxCell>

        <!-- M03 + EX01 -->
        <mxCell id="m03" value="📙 Module 03 + EX01&lt;br/&gt;&lt;b&gt;Requirements Aspect&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;• FR / NFR / Constraints / Future&lt;br/&gt;• SMART requirements&lt;br/&gt;• System Context Diagram&lt;br/&gt;• Use Case Model&lt;br/&gt;• MoSCoW prioritization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e67c00;strokeColor=#bf6200;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="185" height="155" as="geometry" />
        </mxCell>

        <!-- M04 -->
        <mxCell id="m04" value="📕 Module 04&lt;br/&gt;&lt;b&gt;Decisions &amp; Principles&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;• AD template (6 fields)&lt;br/&gt;• Policy &gt; Principle &gt; Guideline&lt;br/&gt;• Solution Optimization patterns&lt;br/&gt;• Fit-for-purpose decisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d32f2f;strokeColor=#b71c1c;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="185" height="145" as="geometry" />
        </mxCell>

        <!-- M05 + EX02 -->
        <mxCell id="m05" value="📓 Module 05 + EX02&lt;br/&gt;&lt;b&gt;Architecture Overview&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;• Communication artefact&lt;br/&gt;• Functional + Operational views&lt;br/&gt;• Audience-tailored&lt;br/&gt;• Best practices + anti-patterns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a1b9a;strokeColor=#4a148c;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="70" width="185" height="145" as="geometry" />
        </mxCell>

        <!-- M06 + EX03 -->
        <mxCell id="m06" value="📒 Module 06 + EX03&lt;br/&gt;&lt;b&gt;Functional Aspect&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;• Component Model (static + dynamic)&lt;br/&gt;• Cohesion, Coupling, Isolation&lt;br/&gt;• 3 steps: Identify → Specify → Implement&lt;br/&gt;• Layering principles&lt;br/&gt;• Sequence diagrams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="280" width="185" height="165" as="geometry" />
        </mxCell>

        <!-- M07 + EX04+05 -->
        <mxCell id="m07" value="📔 Module 07 + EX04+05&lt;br/&gt;&lt;b&gt;Operational Aspect&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;• Location → DU → LOM → POM&lt;br/&gt;• Nodes, Locations, Zones&lt;br/&gt;• Deployment Units (U/E/D/I)&lt;br/&gt;• Cloud deployment models&lt;br/&gt;• Transaction walkthroughs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
