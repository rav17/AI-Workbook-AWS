  <diagram name="ECS Component Model" id="ecs_component_model">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="ECS — Logical Component Model (Exercise 03)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- ====== ACTORS ====== -->
        <mxCell id="actor_respondent" value="&lt;&lt;actor&gt;&gt;&lt;br/&gt;&lt;b&gt;Respondent&lt;/b&gt;" style="shape=mxgraph.basic.person;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="50" height="70" as="geometry" />
        </mxCell>
        <mxCell id="actor_respondent_lbl" value="Respondent" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="18" y="405" width="95" height="20" as="geometry" />
        </mxCell>

        <mxCell id="actor_admin" value="&lt;&lt;actor&gt;&gt;&lt;br/&gt;&lt;b&gt;DoS Admin&lt;/b&gt;" style="shape=mxgraph.basic.person;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="50" height="70" as="geometry" />
        </mxCell>
        <mxCell id="actor_admin_lbl" value="DoS Admin" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="18" y="555" width="95" height="20" as="geometry" />
        </mxCell>

        <!-- ====== SUBSYSTEM: ECS Frontend ====== -->
        <mxCell id="sub_frontend" value="ECS Frontend Subsystem" style="swimlane;fontStyle=1;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="260" width="480" height="200" as="geometry" />
        </mxCell>

        <!-- DialogControl component -->
        <mxCell id="dialog_ctrl_comp" value="&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;DialogControl&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;+ renderPage(section)&lt;br/&gt;+ navigateNext()&lt;br/&gt;+ navigatePrev()&lt;br/&gt;+ handleTimeout()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="sub_frontend">
          <mxGeometry x="30" y="40" width="180" height="130" as="geometry" />
        </mxCell>

        <!-- AuthService component -->
        <mxCell id="auth_svc_comp" value="&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;AuthenticationService&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;+ authenticate(cfn, ecn)&lt;br/&gt;+ invalidate(token)&lt;br/&gt;+ validateToken(token)&lt;br/&gt;+ lockAccount(cfn)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="sub_frontend">
          <mxGeometry x="270" y="40" width="180" height="130" as="geometry" />
        </mxCell>

        <!-- ====== SUBSYSTEM: ECS Form Processing ====== -->
        <mxCell id="sub_form" value="ECS Form Processing Subsystem" style="swimlane;fontStyle=1;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="490" width="680" height="200" as="geometry" />
        </mxCell>

        <!-- FormEngine component -->
        <mxCell id="form_eng_comp" value="&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;FormEngine&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;+ loadSection(token, secId)&lt;br/&gt;+ saveAnswer(token, qId, ans)&lt;br/&gt;+ validateSection(token, secId)&lt;br/&gt;+ getProgress(token)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="sub_form">
          <mxGeometry x="30" y="40" width="180" height="130" as="geometry" />
        </mxCell>

        <!-- SubmissionService component -->
        <mxCell id="sub_svc_comp" value="&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;SubmissionService&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;+ submitForm(token, formData)&lt;br/&gt;+ generateReceipt(formId)&lt;br/&gt;+ checkSubmitted(cfn)&lt;br/&gt;+ transferToDoS(batch)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="sub_form">
          <mxGeometry x="250" y="40" width="185" height="130" as="geometry" />
        </mxCell>

        <!-- NotificationService component -->
        <mxCell id="notif_svc_comp" value="&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;NotificationService&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;+ sendSMS(collector, cfn)&lt;br/&gt;+ sendReceipt(respondent)&lt;br/&gt;+ queueBatch(notifications)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="sub_form">
          <mxGeometry x="470" y="40" width="180" height="130" as="geometry" />
        </mxCell>

        <!-- ====== SUBSYSTEM: Technical Infrastructure ====== -->
        <mxCell id="sub_tech" value="Technical Infrastructure Subsystem" style="swimlane;fontStyle=1;startSize=25;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="580" height="200" as="geometry" />
        </mxCell>

        <!-- SessionStore component -->
        <mxCell id="session_comp" value="&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;SessionStore&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;+ createSession(userId): token&lt;br/&gt;+ getSession(token): Session&lt;br/&gt;+ invalidate(token)&lt;br/&gt;&lt;i&gt;[IBM Redis]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="sub_tech">
          <mxGeometry x="30" y="40" width="175" height="130" as="geometry" />
        </mxCell>

        <!-- DataAccessLayer component -->
        <mxCell id="dal_comp" value="&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;DataAccessLayer&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;+ saveFormData(formId, data)&lt;br/&gt;+ getFormData(formId): Form&lt;br/&gt;+ lookupCredentials(cfn, ecn)&lt;br/&gt;&lt;i&gt;[IBM PostgreSQL]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="sub_tech">
          <mxGeometry x="235" y="40" width="175" height="130" as="geometry" />
        </mxCell>

        <!-- APIGateway component -->
        <mxCell id="apigw_comp" value="&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;APIGateway&lt;/b&gt;&lt;br/&gt;─────────────────&lt;br/&gt;+ transferBatch(returns)&lt;br/&gt;+ sendCollectorNotification()&lt;br/&gt;+ sendDailyReport()&lt;br/&gt;&lt;i&gt;[IBM API Connect]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="sub_tech">
          <mxGeometry x="440" y="40" width="105" height="130" as="geometry" />
        </mxCell>

        <!-- ====== EXTERNAL SYSTEMS ====== -->
        <mxCell id="dos_sys" value="&lt;&lt;external system&gt;&gt;&lt;br/&gt;&lt;b&gt;DoS Processing System&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="490" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sms_sys" value="&lt;&lt;external system&gt;&gt;&lt;br/&gt;&lt;b&gt;SMS Gateway&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="580" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ====== ARROWS ====== -->
        <!-- Actor → DialogControl -->
        <mxCell id="e_resp_dlg" value="uses" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="actor_respondent" target="dialog_ctrl_comp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_admin_dlg" value="uses" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="actor_admin" target="dialog_ctrl_comp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DialogControl → AuthService -->
        <mxCell id="e_dlg_auth" value="calls" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="dialog_ctrl_comp" target="auth_svc_comp" parent="sub_frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DialogControl → FormEngine -->
        <mxCell id="e_dlg_form" value="delegates to" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="dialog_ctrl_comp" target="form_eng_comp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AuthService → SessionStore -->
        <mxCell id="e_auth_sess" value="manages sessions" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="auth_svc_comp" target="session_comp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AuthService → DAL -->
        <mxCell id="e_auth_dal" value="lookup credentials" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="auth_svc_comp" target="dal_comp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FormEngine → DAL -->
        <mxCell id="e_form_dal" value="persists data" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="form_eng_comp" target="dal_comp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FormEngine → SubmissionService -->
        <mxCell id="e_form_sub" value="triggers on complete" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="form_eng_comp" target="sub_svc_comp" parent="sub_form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SubmissionService → NotificationService -->
        <mxCell id="e_sub_notif" value="triggers" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="sub_svc_comp" target="notif_svc_comp" parent="sub_form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SubmissionService → APIGateway -->
        <mxCell id="e_sub_api" value="batch transfer" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="sub_svc_comp" target="apigw_comp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- NotificationService → APIGateway (for SMS) -->
        <mxCell id="e_notif_api" value="dispatch SMS" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="notif_svc_comp" target="apigw_comp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- APIGateway → DoS / SMS external systems -->
        <mxCell id="e_api_dos" value="REST/API" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="apigw_comp" target="dos_sys" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_api_sms" value="SMPP/API" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="apigw_comp" target="sms_sys" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Layering principle note -->
        <mxCell id="layer_note" value="Layering principle:&lt;br/&gt;DialogControl (UI) → FormEngine (Business) → DataAccessLayer (Data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="730" width="680" height="40" as="geometry" />
        </mxCell>

        <!-- Cohesion/Coupling note -->
        <mxCell id="cc_note" value="Design principles applied: High Cohesion ✅ | Loose Coupling ✅ | Layered Architecture ✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="730" width="530" height="40" as="geometry" />
        </mxCell>

