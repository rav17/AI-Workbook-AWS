        <!-- INPUT: Requirements -->
        <mxCell id="req_box" value="&lt;b&gt;Requirements&lt;/b&gt;&lt;br/&gt;&lt;i&gt;What must the system do?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Functional Requirements&lt;br/&gt;• Non-Functional Requirements&lt;br/&gt;• Constraints&lt;br/&gt;• Future Requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
