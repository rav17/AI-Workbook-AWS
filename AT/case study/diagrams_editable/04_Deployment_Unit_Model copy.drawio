        <mxCell id="legend" value="DU Naming Convention:  U_ = Presentation (user-facing)  |  D_ = Data  |  E_ = Execution  |  I_ = Installation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFEE;strokeColor=#999;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="1100" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note" value="NOTE: These DU characterizations drive placement decisions in the LOM (Exercise 5).&#xa;High concurrency + fast response → needs auto-scaling nodes. Large data + permanent → needs HA database. Async + heavy → separate batch node." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#C00000;fontSize=9;fontStyle=2;align=left;spacingLeft=10;" vertex="1" parent="1">
